// The Python Worker serving server/app.py -- /api/*, /admin/* and /clips/* for
// the staging tier. `task api:dev` runs it locally.
//
// Named wrangler.jsonc because pywrangler reads no other name. Wrangler
// auto-loads it too, and that is harmless: `wrangler pages deploy` and `pages
// dev` ignore a config with no pages_build_output_dir (with a warning), and a
// `wrangler d1` command naming a database this file does not bind looks it up by
// name, as it does with no config at all.
//
// The Worker ships .api-bundle/, which `task api:bundle` (scripts/api-bundle.sh)
// stages from server/ and web/alias.json, rather than the repo root: wrangler uploads every .py under
// the module root and its rules cannot narrow that, so a root base_dir would
// ship every script in the repo and the whole .venv.
{
  "name": "adanalife-guessr-staging-api",
  "main": ".api-bundle/server/worker.py",
  "base_dir": ".api-bundle",
  // rules.py reads the wordlist the page draws aliases from at import.
  "rules": [{ "type": "Data", "globs": ["web/alias.json"], "fallthrough": true }],
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adanalife-guessr-answers-staging",
      "database_id": "a76a44d4-7c09-4b07-8ad3-625c63df5658"
    }
  ],
  // One bucket for every tier: a clip is the same bytes whichever tier serves
  // it (see BUCKET in Taskfile.yml).
  "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "adanalife-guessr-clips" }]
  // Who administers is three secrets, none declared here: Dana's Twitch user id
  // (TWITCH_OWNER_ID), the adanalife_ broadcaster id (TWITCH_CHANNEL_ID), and the
  // tempomat/console client ids, comma-separated (TWITCH_CLIENT_IDS). None lives
  // in this repo; `wrangler secret put <NAME>` sets each. Unset admits nobody.
}

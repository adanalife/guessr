// The Python Worker serving server/app.py -- /api/* and /admin/*. Its /clips/*
// route is local-dev only: Pages serves clips straight from R2.
// The top level is the staging tier; `env.production` is the production one,
// deployed by release.yml with `--env production`. `task api:dev` runs it
// locally.
//
// In api/ rather than at the repo root, and named wrangler.jsonc, for two tools
// at once. pywrangler reads no other name, and only beside its pyproject.toml.
// Wrangler auto-loads that name from the directory it runs in or any parent, and
// the `wrangler pages deploy` runs at the root would then take this Worker's
// main and bindings as the site's -- so the name is safe only down here.
//
// The Worker ships api/bundle/, which `task api:bundle` (scripts/api-bundle.sh)
// stages from server/ and web/alias.json, rather than the repo: wrangler uploads
// every .py under the module root and its rules cannot narrow that, so the repo
// root would ship every script and the whole .venv.
{
  "name": "adanalife-guessr-staging-api",
  "main": "bundle/server/worker.py",
  "base_dir": "bundle",
  // rules.py reads the wordlist the page draws aliases from at import.
  "rules": [{ "type": "Data", "globs": ["web/alias.json"], "fallthrough": true }],
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["python_workers"],
  // Reached through the Pages project's `API` service binding and nowhere else:
  // the workers.dev hostname would answer the whole API on a name nothing uses.
  "workers_dev": false,
  // Every request's log and trace, kept in Workers Logs, with Issues grouping
  // the exceptions. Without it, an invocation that dies over the CPU or memory
  // limit, or throws past the ASGI app (a client sees a bare 1101), leaves
  // nothing but a count in the analytics. Sampled at 1 because the whole game
  // is a few thousand requests a day, far under the logging allowance. Query
  // strings stay: they carry only dates and board names, and a player's id
  // travels in POST bodies, which are never logged. Inherited by
  // env.production.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
    "issues": { "enabled": true }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adanalife-guessr-answers-staging",
      "database_id": "a76a44d4-7c09-4b07-8ad3-625c63df5658",
      // The repo's migrations, for `wrangler d1 migrations apply --local` here.
      "migrations_dir": "../migrations"
    }
  ],
  // One bucket for every tier: a clip is the same bytes whichever tier serves
  // it (see BUCKET in Taskfile.yml).
  "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "adanalife-guessr-clips" }],
  // Production: the same code against the production D1. Bindings do not
  // inherit across wrangler environments, so each is declared again; main,
  // rules and compatibility do inherit. Its three admin secrets are set once
  // more with `wrangler secret put <NAME> --env production`.
  "env": {
    "production": {
      "name": "adanalife-guessr-api",
      "workers_dev": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "adanalife-guessr-answers",
          "database_id": "121f1d0c-5212-482e-bbc2-ceab1084f279",
          "migrations_dir": "../migrations"
        }
      ],
      "r2_buckets": [{ "binding": "CLIPS", "bucket_name": "adanalife-guessr-clips" }]
    }
  }
  // Who administers is three secrets, none declared here: the owner Twitch user
  // ids (TWITCH_OWNER_ID -- Dana's, plus the staging account's on stage), the
  // adanalife_ broadcaster id (TWITCH_CHANNEL_ID), and the tempomat/console
  // client ids (TWITCH_CLIENT_IDS); the id lists comma-separated. None lives
  // in this repo; `wrangler secret put <NAME>` sets each. Unset admits nobody.
}

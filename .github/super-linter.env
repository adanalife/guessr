# Excluded paths:
#   - web/leaflet/, web/et-book/, web/sentry/: vendored third-party
#     assets (the Leaflet dist bundle, the ET Book webfont, the Sentry
#     replay bundle), kept byte-for-byte as upstream ships them so a
#     version bump stays a clean wholesale replace — codespell reads a
#     minified bundle's two-letter names as typos.
#     .pre-commit-config.yaml excludes the same three dirs.
#   - CHANGELOG.md and changelog.d/: towncrier's output and its input.
#     Fragments are a single sentence with no heading and the collated
#     file repeats a section heading per release — markdownlint's MD041
#     and MD024 by construction.
#   - towncrier-template.md: a Jinja template that *produces* markdown;
#     towncrier picks its markup from the .md extension, but the
#     `{% %}`/`[...]` syntax isn't valid markdown.
FILTER_REGEX_EXCLUDE=.*web/(et-book|leaflet|sentry)/.*|.*(^|/)CHANGELOG\.md$|.*changelog\.d/.*|.*(^|/)towncrier-template\.md$
# Biome wants to reformat release-please's own manifest/config JSON,
# which release-please then rewrites on its next run. Disabled across
# the release-please repos in the fleet for the same reason.
VALIDATE_BIOME_FORMAT=false
# Biome lint runs in pre-commit instead, pinned to the same version as
# biome.json's `$schema`. super-linter bundles its own biome (2.5.0 in
# v8.7.0), which refuses a config whose schema is
# newer than itself and reports a false `suppressions/unused` on the
# multi-line ignore in web/index.html. Two gates over the same files at
# two versions can only disagree; the pinned one wins.
VALIDATE_BIOME_LINT=false
# Copy-paste detection is noise on a codebase this small.
VALIDATE_JSCPD=false
# Prettier: the repo has no Prettier config and no Prettier hook, so
# these grade every hand-written file against a style nothing else
# enforces. Adopting Prettier means a repo-wide reformat plus a
# pre-commit hook to hold the line — a deliberate change, not a side
# effect of the weekly sweep.
VALIDATE_CSS_PRETTIER=false
VALIDATE_HTML_PRETTIER=false
VALIDATE_JAVASCRIPT_PRETTIER=false
VALIDATE_JSON_PRETTIER=false
VALIDATE_JSONC_PRETTIER=false
VALIDATE_MARKDOWN_PRETTIER=false
VALIDATE_YAML_PRETTIER=false
# shfmt indents with tabs; the shell scripts here use two spaces. Same
# story as the Prettier block — a formatter the repo hasn't adopted.
VALIDATE_SHELL_SHFMT=false
# Biome is the JavaScript linter for this repo; ESLint duplicates it,
# and super-linter warns when both run over the same files.
VALIDATE_JAVASCRIPT_ES=false
# Python lint and format live in .pre-commit-config.yaml (Ruff, both
# halves). The rest either duel with it (BLACK, RUFF_FORMAT, ISORT) or
# grade the standalone scripts against rules the repo hasn't adopted
# (MYPY, PYLINT, FLAKE8). PYTHON_RUFF — the same linter pre-commit
# runs — stays on.
VALIDATE_PYTHON_BLACK=false
VALIDATE_PYTHON_RUFF_FORMAT=false
VALIDATE_PYTHON_MYPY=false
VALIDATE_PYTHON_PYLINT=false
VALIDATE_PYTHON_FLAKE8=false
VALIDATE_PYTHON_ISORT=false
# textlint grades prose against writing-style rules; CHANGELOG.md and
# README.md are written for players, not for a style guide.
VALIDATE_NATURAL_LANGUAGE=false
# sqlfluff refuses to run without a dialect, and picking one (D1 is
# SQLite) also opts the schema into sqlfluff's layout rules — a
# separate decision from getting this sweep meaningful.
VALIDATE_SQLFLUFF=false

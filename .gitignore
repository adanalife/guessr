# The round set (web/frames/ + web/rounds.json) IS tracked, even though
# make_rounds.py generates it. Generating it needs the dashcam corpus mounted
# and database access, neither of which CI has, so the committed set is the
# only copy a deploy can reach. Regenerating rewrites ~27 MB of JPEGs, so
# regenerate deliberately rather than as a habit.

__pycache__/
.venv/
.DS_Store
.ruff_cache/
